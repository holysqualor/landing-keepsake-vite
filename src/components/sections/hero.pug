section#top.hero(aria-labelledby='hero-title')
  .container.hero__grid
    .hero__copy
      p.eyebrow Незалежна дизайн-студія / Україна
      h1#hero-title.hero__title Дизайн, який <em>залишається</em> з вами.
      p.hero__lead Створюємо бренди та цифрові історії, що знаходять відгук і не губляться серед інших.
      +btn('Дивитися роботи', '#works')
    .hero__art(aria-hidden='true')
      .hero__circle
        span K.
      span.hero__art-label Crafted to be remembered
  .container.hero__bottom
    span Естетика в кожній деталі
    span 01 — 06
